{
    "inputSchema": {
        "type": "object",
        "properties": {
            "document": {
                "type": "integer",
                "minimum": 1,
                "description": "Identifier of the Elementor document to change. Call elementor-document-list for the documents Elementor controls."
            },
            "content": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5000,
                "items": {
                    "type": "object",
                    "maxProperties": 32
                },
                "description": "The layout to write, shaped exactly as elementor-document-get reports a document's content. Every setting key must be one the widget carrying it declares, or the request is refused rather than stored with the unrecognised keys dropped."
            }
        },
        "required": [
            "document",
            "content"
        ],
        "additionalProperties": false
    },
    "outputSchema": {
        "type": "object",
        "oneOf": [
            {
                "title": "Plan phase",
                "type": "object",
                "properties": {
                    "plan": {
                        "type": "object",
                        "description": "The change plan to approve, including its plan token."
                    }
                },
                "required": [
                    "plan"
                ],
                "additionalProperties": false
            },
            {
                "title": "Apply phase",
                "type": "object",
                "properties": {
                    "target": {
                        "type": "string",
                        "description": "The concrete target that was written."
                    },
                    "changed": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "The fields the approved plan changed."
                    },
                    "state": {
                        "type": "object",
                        "properties": {
                            "documentDigest": {
                                "type": "string",
                                "description": "Fingerprint of the document exactly as it is stored. Two reads of an unchanged document give the same value."
                            },
                            "elementCount": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "How many elements the stored document holds, counting every nesting level."
                            },
                            "maxDepth": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "How many nesting levels the stored document has. An empty document has none."
                            },
                            "widgetTypeCounts": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "description": "How many of each widget type the stored document holds, keyed by widget type name."
                            }
                        },
                        "required": [
                            "documentDigest",
                            "elementCount",
                            "maxDepth",
                            "widgetTypeCounts"
                        ],
                        "additionalProperties": false
                    }
                },
                "required": [
                    "target",
                    "changed",
                    "state"
                ],
                "additionalProperties": false
            }
        ]
    }
}
