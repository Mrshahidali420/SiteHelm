                        "additionalProperties": false
                    },
                    {
                        "title": "Apply phase",
                        "type": "object",
                        "properties": {
                            "target": {
                                "type": "string",
                                "description": "The concrete target that was written."
                            },
                            "changed": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "The fields the approved plan changed."
                            },
                            "state": {
                                "type": "object",
